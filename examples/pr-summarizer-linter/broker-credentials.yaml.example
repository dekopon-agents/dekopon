# The one file in this example that holds a secret.
#
#   cp broker-credentials.yaml.example broker-credentials.yaml
#   chmod 600 broker-credentials.yaml
#
# Stricter than broker.yaml on purpose: broker.yaml rejects group/world *writability*, while this
# file rejects group/world *anything* (mode & 0o077), because readability is the threat. It must
# also be a regular single-link file owned by the broker's UID.
#
# Use a GitHub fine-grained personal access token scoped to only the repositories this agent may
# review:
#
#   Contents: Read-only           (gh.content.read)
#   Pull requests: Read and write (metadata/files/diff reads and one COMMENT review)
#   Checks: Read-only             (gh.pull-request.status)
#
# GitHub has no narrower permission for a COMMENT review. Dekopon narrows that broad provider
# permission by exposing `gh.pull-request.comment` as its own action, omitting approval,
# request-changes, merge, and raw `gh.api.*`, and binding this credential to api.github.com and the
# six constraint sets in broker.yaml. The token's repository scope remains the boundary on which
# repositories are reachable because Cedar does not inspect provider input paths.
#
# The value below is an unmistakable placeholder. Replace it, and never commit the result.
apiVersion: dekopon.dev/broker-credentials/v1alpha1
credentials:
  - name: github-pat
    kind: bearerToken
    scheme: Bearer
    # Every `allowedHosts` entry in every constraint set binding this credential must appear here.
    # The broker injects `authorization: Bearer <secret>` only for these destinations, after guest
    # headers are validated, and audit records `credentialInjected: true` — never the value.
    destinations: [api.github.com]
    secret: github_pat_XXXXXXXXXXXXXXXXXXXXXX_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
