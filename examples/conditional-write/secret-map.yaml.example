# The broker's private secret map. It names where the token lives, never the token itself.
#
#   cp secret-map.yaml.example secret-map.yaml
#   chmod 600 secret-map.yaml
#   install -m 600 /dev/stdin /home/you/.config/dekopon/api-token   # paste the token, then ^D
#
# The token: whatever bearer token the upstream API issues for the record this agent maintains,
# scoped as narrowly as that API allows. Most APIs have no permission narrower than "write", which
# is why the narrowing happens here: each binding pins the capabilities, hosts, methods and paths
# the token is injected for, and `http-probe.purge` appears in none of them.
apiVersion: dekopon.dev/secret-map/v1alpha1
mapRevision: example-1
secrets:
  - drn: drn:secret:example/api-token
    destinations: [api.example.com]
    source:
      kind: secureFile
      path: /home/you/.config/dekopon/api-token
    bindings:
      - id: api-token-fetch
        capabilities: [http-probe.fetch]
        sink: httpBearer
        allowedHosts: [api.example.com]
        allowedMethods: [GET]
        allowedPaths: [{ match: segmentPrefix, path: / }]
      - id: api-token-conditional-write
        capabilities: [http-probe.conditional-write]
        sink: httpBearer
        allowedHosts: [api.example.com]
        allowedMethods: [GET, POST]
        allowedPaths: [{ match: segmentPrefix, path: / }]
        maxInjections: 2
