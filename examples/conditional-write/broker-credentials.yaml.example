# The one file in this example that holds a secret.
#
#   cp broker-credentials.yaml.example broker-credentials.yaml
#   chmod 600 broker-credentials.yaml
#
# Stricter than broker.yaml on purpose: broker.yaml rejects group/world *writability*, this file
# rejects group/world *anything* (mode & 0o077), because readability is the whole threat. It must
# also be a regular single-link file owned by the broker's UID. A group-readable file is a startup
# failure, not a warning.
#
# The token needed: whatever bearer token the upstream API issues for the record this agent
# maintains, scoped as narrowly as that API allows — read on the resource, and write on the same
# resource and nothing else.
#
# Most APIs have no permission narrower than "write", which is exactly why the narrowing happens
# here instead. `http-probe.conditional-write` is its own action in policies.cedar, the component
# exposes no generic passthrough, and the broker's constraint sets bind this credential to
# api.example.com and to those two capabilities alone. The manifest also exposes `http-probe.purge`,
# which this example grants nowhere — a token that could delete the record cannot reach a capability
# no constraint set describes.
#
# The value below is a placeholder and is not a token. Replace it, and never commit the result.
apiVersion: dekopon.dev/broker-credentials/v1alpha1
credentials:
  - name: api-token
    kind: bearerToken
    scheme: Bearer
    # Every `allowedHosts` entry in every constraint set binding this credential must appear here,
    # checked at startup. The broker injects `authorization: Bearer <secret>` only for these
    # destinations, only after guest headers were validated, and records `credentialInjected: true`
    # in audit — never the value.
    destinations: [api.example.com]
    secret: replace-me_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
