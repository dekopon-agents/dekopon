# The one file in this example that holds a secret.
#
#   cp broker-credentials.yaml.example broker-credentials.yaml
#   chmod 600 broker-credentials.yaml
#
# Stricter than broker.yaml on purpose: broker.yaml rejects group/world *writability*, this file
# rejects group/world *anything* (mode & 0o077), because readability is the whole threat. It must
# also be a regular single-link file owned by the broker's UID. A group-readable file is a startup
# failure, not a warning.
#
# The token needed, as a GitHub fine-grained personal access token scoped to the repositories the
# agent may review:
#
#   Contents: Read-only           (gh.content.read)
#   Pull requests: Read and write (gh.pull-request.list / .read / .files, and .approve)
#
# "Read and write" on pull requests is what submitting a review costs; there is no narrower GitHub
# permission for an APPROVE event. What keeps that from being approval authority over everything
# the token can reach is the capability split: `gh.pull-request.approve` is its own action in
# policies.cedar, the gh component has no `gh.api.*` passthrough, and the broker's constraint sets
# bind this credential to api.example.com and to those five capabilities alone. GitHub also refuses
# to let a token approve its own user's pull requests, which is worth knowing before testing.
#
# The value below is a placeholder and is not a token. Replace it, and never commit the result.
apiVersion: dekopon.dev/broker-credentials/v1alpha1
credentials:
  - name: api-token
    kind: bearerToken
    scheme: Bearer
    # Every `allowedHosts` entry in every constraint set binding this credential must appear here,
    # checked at startup. The broker injects `authorization: Bearer <secret>` only for these
    # destinations, only after guest headers were validated, and records `credentialInjected: true`
    # in audit — never the value.
    destinations: [api.example.com]
    secret: github_pat_XXXXXXXXXXXXXXXXXXXXXX_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
