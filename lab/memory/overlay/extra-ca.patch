+pub(crate) mod lab_extra_ca {
+    const PEM: &[u8] = include_bytes!(concat!(env!("CARGO_MANIFEST_DIR"), "/lab-extra-ca.pem"));
+
+    pub(crate) fn ureq_tls() -> ureq::tls::TlsConfig {
+        let certificates: Vec<_> = ureq::tls::parse_pem(PEM)
+            .filter_map(|item| match item {
+                Ok(ureq::tls::PemItem::Certificate(certificate)) => Some(certificate),
+                _ => None,
+            })
+            .collect();
+        ureq::tls::TlsConfig::builder()
+            .root_certs(ureq::tls::RootCerts::new_with_certs(&certificates))
+            .build()
+    }
+
+    pub(crate) fn reqwest_roots() -> Vec<reqwest::Certificate> {
+        reqwest::Certificate::from_pem_bundle(PEM).unwrap_or_default()
+    }
+}
