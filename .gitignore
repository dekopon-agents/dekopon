/target/
/examples/providers/*/target/

# Exact standalone-provider fixtures fetched by ci/fetch-external-provider-components.sh.
# Core owns neither their source nor generated Wasm bytes.
/examples/providers/echo-provider.wasm
/examples/providers/echo-provider.wasm.sha256
/examples/providers/jsonplaceholder-provider.wasm
/examples/providers/jsonplaceholder-provider.wasm.sha256
/examples/providers/memory-chat-provider.wasm
/examples/providers/memory-chat-provider.wasm.sha256
.DS_Store
*.swp
*.swo
.env
.env.*
!.env.example
coverage/
__pycache__/

# The conditional-write walkthrough tells a reader to copy the .example beside this path and paste
# a live API bearer token into it. Ignoring it here means following the walkthrough cannot commit a
# secret, which examples/conditional-write/README.md promises it cannot.
/examples/conditional-write/broker-credentials.yaml

# Code-review artifacts; system of record is the vagus vault, not git history.
/docs/review-2026-07/

# Container image build input, in case a release is ever extracted into the checkout rather than
# into the scratch directory ci/stage-image-context.sh stages. Never repository content; see
# docs/container-image.md.
/dist/
