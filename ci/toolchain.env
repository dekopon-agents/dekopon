# Component toolchain pin. Do not touch this unless you are moving all of these in lockstep:
#   rust-toolchain.toml            one Rust for the workspace, the fixtures and every CI job
#   Cargo.toml rust-version        the same number, kept for crates.io metadata
#   Cargo.toml wasmtime, wit-bindgen, and the seven examples/providers/*/Cargo.toml wit-bindgen pins
#   ci/toolchain.env               wasm-tools and wkg, with their sha256
#   deny.toml [[skip]]             wasm-encoder / wasmparser / wit-parser versions
# then rebuild every examples/providers/*.wasm on the pinned CI image.
# wit-bindgen's generated code must agree with the wasm-tools CLI and with Wasmtime's component
# model crates. History: #206; #191 is the lone wit-bindgen bump that could not build.
WASM_TOOLS_VERSION=1.259.0
WASM_TOOLS_SHA256=3e9b374b4c7715b771b69bf0d65a337990ed4546ec5e97e01c0ff587dfc52160
WKG_VERSION=0.16.0
WKG_SHA256=8ab0f7138e1a84616cb0c87c2bd7b7d00a356b63d458be92bad3fbd463aa3e2a
