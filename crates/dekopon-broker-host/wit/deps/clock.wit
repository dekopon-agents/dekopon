package dekopon:clock@1.1.0;

/// The broker host's wall clock, readable during `invoke` only.
interface wall {
    /// Milliseconds since 1970-01-01T00:00:00Z. The host's clock, not the guest's.
    now-unix-millis: func() -> u64;
}

/// Elapsed time within one invocation, readable during `invoke` only.
interface monotonic {
    /// Nanoseconds since this invocation started, shared by every component in the invocation.
    /// Not comparable across invocations.
    now-nanos: func() -> u64;
}
