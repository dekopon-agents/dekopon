package dekopon:broker-provider@0.4.0;

/// Broker provider world with buffered HTTP and exact storage authority supplied per invocation,
/// the host wall clock readable during an invocation, and live standard streams.
world provider {
    include dekopon:provider/provider@0.4.0;
    import dekopon:asset/asset@0.1.0;
    import dekopon:http/client@1.1.0;
    import dekopon:storage/jsonl@0.1.1;
    import dekopon:storage/durable-files@0.1.1;
    import dekopon:clock/wall@1.1.0;
    import dekopon:clock/monotonic@1.1.0;
    import dekopon:random/source@0.1.0;
    import dekopon:settings/config@0.1.0;
    import dekopon:spawn/run@0.1.0;
}
